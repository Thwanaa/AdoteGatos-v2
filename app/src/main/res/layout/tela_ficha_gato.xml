<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/raiz_ficha"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".FichaGatoActivity">

    <LinearLayout
        android:id="@+id/ficha_conteudo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Cabeçalho: foto + gradiente + toolbar + nome e etiquetas -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/cabecalho_altura"
            android:layout_marginBottom="@dimen/cartao_intervalo">

            <ImageView
                android:id="@+id/ficha_foto"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                tools:ignore="ContentDescription"
                tools:src="@drawable/gato_mel" />

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/degrade_cabecalho" />

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/ficha_toolbar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                app:navigationContentDescription="@string/voltar"
                app:navigationIcon="@drawable/ic_seta_esquerda" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:id="@+id/ficha_nome"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:textSize="28sp"
                    tools:text="Mel" />

                <LinearLayout
                    android:id="@+id/etiquetas_linha_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:orientation="horizontal" />

                <LinearLayout
                    android:id="@+id/etiquetas_linha_2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </LinearLayout>
        </FrameLayout>

        <!-- Card: Sobre -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/cartao_margem"
            android:layout_marginBottom="@dimen/cartao_intervalo"
            android:background="@drawable/fundo_cartao"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/cartao_espaco_horizontal"
            android:paddingVertical="@dimen/cartao_espaco_vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="@string/titulo_sobre"
                android:textColor="?attr/colorPrimary"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/texto_historia"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineHeight="22sp"
                tools:text="História do gato" />
        </LinearLayout>

        <!-- Card: Processo de adoção -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/cartao_margem"
            android:layout_marginBottom="@dimen/cartao_intervalo"
            android:background="@drawable/fundo_cartao"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/cartao_espaco_horizontal"
            android:paddingVertical="@dimen/cartao_espaco_vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="@string/processo_adocao"
                android:textColor="?attr/colorPrimary"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/texto_nome_etapa"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                tools:text="Entrevista com a ONG" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/texto_etapa"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/jetbrains_mono"
                    android:textSize="11sp"
                    tools:text="Etapa 2 / 4" />

                <TextView
                    android:id="@+id/texto_percentual"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/jetbrains_mono"
                    android:textSize="11sp"
                    tools:text="50%" />
            </LinearLayout>

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/barra_progresso"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:max="100" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/botao_voltar_etapa"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="8dp"
                    android:contentDescription="@string/etapa_anterior_button"
                    android:src="@drawable/ic_seta_esquerda"
                    app:fabSize="mini" />

                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/botao_avancar_etapa"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="8dp"
                    android:contentDescription="@string/proxima_etapa_button"
                    android:src="@drawable/ic_seta_direita" />
            </LinearLayout>
        </LinearLayout>

        <!-- Card: Detalhes -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/cartao_margem"
            android:layout_marginBottom="@dimen/cartao_margem"
            android:background="@drawable/fundo_cartao"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/cartao_espaco_horizontal"
            android:paddingVertical="@dimen/cartao_espaco_vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/detalhes"
                android:textColor="?attr/colorPrimary"
                android:textSize="24sp" />

            <com.google.android.material.divider.MaterialDivider
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/sexo" />

                <TextView
                    android:id="@+id/texto_sexo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textAlignment="textEnd" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/porte" />

                <TextView
                    android:id="@+id/texto_porte"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textAlignment="textEnd" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/resgatado_em" />

                <TextView
                    android:id="@+id/texto_resgate"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textAlignment="textEnd" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/temperamento" />

                <TextView
                    android:id="@+id/texto_temperamento"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textAlignment="textEnd" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
